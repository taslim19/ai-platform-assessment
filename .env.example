# Run python3 scripts/setup_env.py; never commit .env.
APP_ENV=development
POSTGRES_DB=aiqa
POSTGRES_USER=app
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
JWT_ISSUER=aiqa
JWT_AUDIENCE=aiqa-api
JWT_EXPIRY_MINUTES=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
REDIS_MAX_CONNECTIONS=100
STORE_CHAT_CONTENT=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CACHE_TTL_SECONDS=0
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
LLM_MAX_CONCURRENCY=20
LLM_TIMEOUT_SECONDS=20
LLM_TOTAL_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# Optional: export BOOTSTRAP_PASSWORD only while creating an account.
# Optional metrics refresh script: METRICS_USERNAME and METRICS_PASSWORD.
